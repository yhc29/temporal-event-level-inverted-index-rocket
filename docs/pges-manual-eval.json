      "expected": {
        "shouldMatch": true,
        "minPatterns": 1,
        "reason": "T and C must satisfy (◊_a T) and ((◊_b C))_a; small gap between T and C is allowed if consistent with some a,b."
      },
      "relation_focus": {
        "T-C": "C after T (separated by small gap, no overlap)"
      },
      "events": {
        "S": [[15, 80]],
