{
  "name": "pges-manual-evaluation",
  "version": "1.0.0",
  "description": "Manual evaluation set for PGES (∃x∃a∃b∃c [ □_{a+b}S ∧ ◊_{a}T ∧ (◊_{b}C)_{a} ∧ (□_{c}P)_{a+b} ]x). Designed to test if query results accurately express the formula meaning.",
  "created": "2026-10-20",
  "labels": ["S", "T", "C", "P"],
  "formula": {
    "name": "PGES",
    "expr": "∃x ∃a ∃b ∃c [ □_{a+b}S ∧ ◊_{a}T ∧ (◊_{b}C)_{a} ∧ (□_{c}P)_{a+b} ]x",
    "notes": "x = seizure anchor, a = tonic window length, b = clonic window length, c = postictal suppression length. P must be anchored at x+a+b (seizure offset) with no gap."
  },
  "axis_seconds": [0, 240],
  "cases": [
    {
      "id": "ME01",
      "category": "valid_baseline",
      "title": "Classic PGES - clean containment/order",
      "expected": {
        "shouldMatch": true,
        "minPatterns": 1,
        "reason": "T contained in first a of S, C contained after displacement by a in remainder, P starts exactly at S.b"
      },
      "relation_focus": {
        "S-T": "T contained within S (overlapping start region)",
        "T-C": "C after T, no overlap in the chosen split",
        "S-C": "C contained within S",
        "S-P": "P starts at or immediately after S.b",
        "T-P": "T before P with gap (seizure in between)",
        "C-P": "C before P with gap (seizure in between)"
      },
      "events": {
        "S": [[10, 70]],
        "T": [[10, 30]],
        "C": [[32, 68]],
        "P": [[70, 115]]
      },
      "note": "Baseline. P starts exactly at seizure offset x+a+b."
    },
    {
      "id": "ME02",
      "category": "valid_relation_cover",
      "title": "S contains T,C; P meets S at boundary (adjacent)",
      "expected": {
        "shouldMatch": true,
        "minPatterns": 1,
        "reason": "Boundary-adjacent is fine if P starts at S.b. Tests 'meets/after' relation between S and P."
      },
      "relation_focus": {
        "S-P": "P.a == S.b (meets/adjacent, starts at offset)"
      },
      "events": {
        "S": [[0, 50]],
        "T": [[0, 12]],
        "C": [[18, 48]],
        "P": [[50, 90]]
      },
      "note": "Tests boundary case between S and P."
    },
